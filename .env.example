# ── Paso 2: WhatsApp Cloud API (Meta for Developers) ──────────────
# App > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=EAAG...                 # token de acceso (permanente: usuario del sistema)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=elegi-una-frase-secreta   # la misma que pongas en el webhook
WHATSAPP_APP_SECRET=                   # App > Configuración > Básica (valida la firma del webhook)
WHATSAPP_API_VERSION=v21.0
# Plantilla aprobada en Meta para avisar al técnico si no escribió en las últimas 24 h.
# Cuerpo sugerido: "Nueva orden #{{1}} en {{2}}. Respondé este mensaje para ver el detalle."
WHATSAPP_PLANTILLA_TECNICO=nueva_orden
WHATSAPP_PLANTILLA_IDIOMA=es_AR

# ── Paso 3: Modelo vía OpenRouter (cambiás una línea) ─────────────
OPENROUTER_API_KEY=sk-or-...
MODELO=openai/gpt-4o-mini
# MODELO=anthropic/claude-sonnet-4.5
# MODELO=google/gemini-2.5-flash
# MODELO=meta-llama/llama-3.3-70b-instruct
# MODELO=deepseek/deepseek-chat

# ── Paso 4: Memoria ───────────────────────────────────────────────
MAX_HISTORIAL=20          # mensajes que se mandan al modelo en cada turno
DEBOUNCE_MS=2500          # espera para juntar "2 mensajes a la vez" en uno

# ── Oficina: recibe por WhatsApp órdenes nuevas y gestiones ────────
ADMIN_WHATSAPP=5493510000000   # uno o varios separados por coma

# ── Panel web de la oficina: https://TU-DOMINIO/panel ──────────────
PANEL_USUARIO=admin
PANEL_CLAVE=cambiame-por-una-clave-larga

# ── Paso 8: Servidor ──────────────────────────────────────────────
PORT=3000
DATA_DIR=./data
NEGOCIO_FILE=./negocio.json
